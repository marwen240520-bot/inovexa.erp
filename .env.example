# ───────────── Base de données (obligatoire) ─────────────
# Utilisée par Docker Compose pour créer la base ; en dehors de Docker, définissez directement DATABASE_URL.
POSTGRES_USER=inovexa
POSTGRES_PASSWORD=
POSTGRES_DB=inovexa_erp
# DATABASE_URL=postgres://inovexa:motdepasse@localhost:5432/inovexa_erp

# ───────────── Sécurité (obligatoire) ─────────────
# Chaîne aléatoire d'au moins 32 caractères :  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ───────────── Application ─────────────
PORT=3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Inovexa ERP

# ───────────── Emails (factures, relances, bulletins, récapitulatif d'alertes) ─────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ma Société <facturation@exemple.tn>"

# ───────────── Options avancées ─────────────
# DB_SSL=true                 hébergeur PostgreSQL qui impose SSL
# DB_MIGRATIONS_RUN=false     ne pas appliquer les migrations au démarrage (les lancer avec `npm run migration:run:prod`)
# ENABLE_SWAGGER=true         exposer /api/docs en production (désactivé par défaut)
# POS_REQUIRE_SESSION=true    refuser les ventes de caisse hors session ouverte
# FRONTEND_URLS=https://a.exemple.tn,https://b.exemple.tn   origines CORS supplémentaires

# ───────────── Sauvegardes (voir docs/OPERATIONS.md) ─────────────
# BACKUP_PASSPHRASE=          chiffre les sauvegardes (GPG AES-256)
# BACKUP_S3_URI=s3://bucket/inovexa    copie hors serveur
# BACKUP_S3_ENDPOINT=         endpoint S3 compatible (Scaleway, OVH, MinIO…)
