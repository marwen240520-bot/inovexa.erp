# ───────────── Base de données (obligatoire) ─────────────
# Utilisée par Docker Compose pour créer la base ; en dehors de Docker, définissez directement DATABASE_URL.
POSTGRES_USER=inovexa
POSTGRES_PASSWORD=
POSTGRES_DB=inovexa_erp
# DATABASE_URL=postgres://inovexa:motdepasse@localhost:5432/inovexa_erp

# ───────────── Sécurité (obligatoire) ─────────────
# Chaîne aléatoire d'au moins 32 caractères :  openssl rand -base64 48
JWT_SECRET=
# Durée d'une session avant de devoir se reconnecter : 12h par défaut ("30m", "7d"…). Plus elle est courte, moins un jeton volé sert longtemps.
# JWT_EXPIRES_IN=12h
# Nombre de relais (proxy, CDN) entre Internet et l'API, pour lire la vraie adresse IP du visiteur (blocage des tentatives de connexion).
# 1 par défaut (Render, Railway…) ; 2 derrière un CDN en plus (Cloudflare devant Render) ; 0 sans relais.
# TRUST_PROXY=1

# ───────────── Application ─────────────
PORT=3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Inovexa ERP

# ───────────── Emails (code de vérification, reçus, factures, relances, bulletins, alertes) ─────────────
# INDISPENSABLE à l'inscription en libre-service : c'est par email que le client reçoit son code à 6 chiffres.
# Sans serveur d'envoi, le code n'est pas exigé (le client n'est pas enfermé) mais l'adresse n'est pas vérifiée.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ma Société <facturation@exemple.tn>"

# ───────────── Paiement par carte bancaire en ligne — Konnect (konnect.network) ─────────────
# C'est ce qui permet aux clients de s'abonner SEULS, sans que vous validiez quoi que ce soit : ils paient par carte
# (cartes tunisiennes et internationales, e-Dinar) et l'abonnement s'ouvre dès que Konnect confirme l'encaissement.
# Sans ces deux variables, le bouton « Payer par carte » n'est pas proposé.
#   1. Ouvrez un compte marchand Konnect (https://konnect.network) ; pour les essais, un compte sur le bac à sable
#      (https://sandbox.konnect.network) avec KONNECT_ENV=sandbox : cartes de test, aucun débit réel.
#   2. Dans votre tableau de bord Konnect, relevez la clé d'API et l'identifiant du portefeuille (wallet) qui reçoit l'argent.
#   3. API_PUBLIC_URL : adresse publique de CE serveur (ex. https://api.votre-domaine.tn) — Konnect y envoie la confirmation
#      de chaque paiement. Sur Render, RENDER_EXTERNAL_URL est utilisée si API_PUBLIC_URL est vide.
# Les prix sont en dollars US par défaut (Réglages › Devise). Konnect accepte USD, EUR et TND ; en USD/EUR le montant est converti
# par Konnect et vous êtes crédité en dinars.
# KONNECT_API_KEY=
# KONNECT_WALLET_ID=
# KONNECT_ENV=production                       « sandbox » pour les essais
# KONNECT_PAYMENT_METHODS=bank_card,e-DINAR    facultatif : seules valeurs connues de Konnect → bank_card, e-DINAR, wallet
# API_PUBLIC_URL=https://api.votre-domaine.tn

# ───────────── Connexion avec Google et Apple (facultatif) ─────────────
# Sans ces variables, les boutons « Continuer avec Google / Apple » ne sont pas affichés ; l'inscription par email fonctionne toujours.
# GOOGLE_CLIENT_ID : identifiant client OAuth « Application Web » (console Google Cloud › API et services › Identifiants).
#   Origines JavaScript autorisées : https://www.votre-domaine.tn (et http://localhost:3000 pour les essais).
# APPLE_CLIENT_ID : identifiant de service (« Services ID ») Sign in with Apple, créé sur developer.apple.com (compte Apple Developer requis).
#   Domaine : www.votre-domaine.tn — Return URL : https://www.votre-domaine.tn/auth/login
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=

# ───────────── Options avancées ─────────────
# DB_SSL=true                 hébergeur PostgreSQL qui impose SSL
# DB_MIGRATIONS_RUN=false     ne pas appliquer les migrations au démarrage (les lancer avec `npm run migration:run:prod`)
# ENABLE_SWAGGER=true         exposer /api/docs en production (désactivé par défaut)
# POS_REQUIRE_SESSION=true    refuser les ventes de caisse hors session ouverte
# FRONTEND_URLS=https://a.exemple.tn,https://b.exemple.tn   autres adresses du site (CORS, et retour du client après un paiement par carte)

# ───────────── Sauvegardes (voir docs/OPERATIONS.md) ─────────────
# BACKUP_PASSPHRASE=          chiffre les sauvegardes (GPG AES-256)
# BACKUP_S3_URI=s3://bucket/inovexa    copie hors serveur
# BACKUP_S3_ENDPOINT=         endpoint S3 compatible (Scaleway, OVH, MinIO…)
