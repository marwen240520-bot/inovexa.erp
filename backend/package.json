{
  "name": "inovexa-backend",
  "version": "1.0.0",
  "description": "Backend API for Inovexa ERP",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build && node scripts/build/postbuild.js",
    "start": "node dist/main.js",
    "start:nest": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "bash test/e2e/run.sh",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "migration:generate": "ts-node -T scripts/db/make-migration.ts",
    "migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "backup": "bash scripts/ops/backup.sh",
    "restore:check": "bash scripts/ops/verify-restore.sh",
    "admin:create": "ts-node -T src/cli/create-admin.ts",
    "admin:create:prod": "node dist/cli/create-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "braces": "^3.0.3",
    "chokidar": "^3.6.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "compression": "^1.8.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fill-range": "^7.1.1",
    "helmet": "^8.3.0",
    "is-number": "^7.0.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "to-regex-range": "^5.0.1",
    "typeorm": "^0.3.31",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.9",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.35",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^2.0.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^29.5.0",
    "prettier": "^3.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "typeorm": {
      "glob": "^14.0.5"
    },
    "@nestjs/cli": {
      "glob": "^14.0.5"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
